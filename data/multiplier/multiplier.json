{
    "metadata": {
        "inputs": {
            "in1": 32,
            "in2": 32
        },
        "outputs": [
            "R4",
            "RR"
        ],
        "registers": {
            "R1": 32,
            "R2": 32,
            "R3": 32,
            "RR": 1,
            "R4": 32,
            "S": 1
        }
    },
    "initial_box": "Idle",
    "boxes": {
        "Idle": {
            "type": "STATE",
            "actions": [],
            "next": "CheckStart"
        },
        "CheckStart": {
            "type": "DECISION",
            "condition": "S",
            "branches": {
                "0": "Idle",
                "1": "LoadOperands"
            }
        },
        "LoadOperands": {
            "type": "CONDITIONAL",
            "actions": [
                "R1 <= in1",
                "R2 <= in2",
                "RR <= 0"
            ],
            "next": "Setup"
        },
        "Setup": {
            "type": "STATE",
            "actions": [
                "R3 <= 0"
            ],
            "next": "CompareOperands"
        },
        "CompareOperands": {
            "type": "DECISION",
            "condition": "R1 > R2",
            "branches": {
                "0": "Loop",
                "1": "SwapOperands"
            }
        },
        "SwapOperands": {
            "type": "CONDITIONAL",
            "actions": [
                "R1 <= R2",
                "R2 <= R1"
            ],
            "next": "Loop"
        },
        "Loop": {
            "type": "STATE",
            "actions": [],
            "next": "CheckDone"
        },
        "CheckDone": {
            "type": "DECISION",
            "condition": "OR R1",
            "branches": {
                "0": "WriteResult",
                "1": "Accumulate"
            }
        },
        "Accumulate": {
            "type": "CONDITIONAL",
            "actions": [
                "R1 <= R1 - 1",
                "R3 <= R3 + R2"
            ],
            "next": "Loop"
        },
        "WriteResult": {
            "type": "CONDITIONAL",
            "actions": [
                "R4 <= R3",
                "RR <= 1"
            ],
            "next": "Idle"
        }
    }
}